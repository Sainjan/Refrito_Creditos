-- =====================================================================
-- SteaMLBDD - Stored procedures adaptados al diagrama EdgarCood.drawio
--
-- Tablas del diagrama: UsuarioAcceso, UsuarioCliente, Empresa, Persona, infoLog
--
-- Convención de infoLog.numeroError:
--     0      -> operación exitosa (log informativo)
--     45000  -> advertencia de validación (no es un error SQL)
--     otro   -> MYSQL_ERRNO del error real capturado en el handler
--
-- Columnas EXTRA (NO están en el diagrama, las necesitan algunos SP):
--     UsuarioAcceso.numeroIntentos, UsuarioAcceso.ultimoIntento -> Reiniciador_Intentos
--     UsuarioCliente.estado (1 Aprobado, 2 Rechazado, 3 Pendiente) -> Asignado_Estado
-- =====================================================================

CREATE DATABASE IF NOT EXISTS SteaMLBDD;

USE SteaMLBDD;

CREATE TABLE IF NOT EXISTS UsuarioAcceso (
    idUsuarioAcceso INT NOT NULL AUTO_INCREMENT,
    clave VARCHAR(200),
    nombreUsuario VARCHAR(40),
    numeroIntentos INT NOT NULL DEFAULT 0,      -- EXTRA (no está en el diagrama)
    ultimoIntento DATE,                         -- EXTRA (no está en el diagrama)
    PRIMARY KEY (idUsuarioAcceso)
);

CREATE TABLE IF NOT EXISTS UsuarioCliente (
    idCliente INT NOT NULL AUTO_INCREMENT,
    nombre VARCHAR(40),
    ingreso DECIMAL(10,3),
    gastos DECIMAL(10,3),
    historial VARCHAR(100),
    estado TINYINT NOT NULL DEFAULT 3,          -- EXTRA (no está en el diagrama): 1 Aprobado, 2 Rechazado, 3 Pendiente
    PRIMARY KEY (idCliente)
);

CREATE TABLE IF NOT EXISTS Empresa (
    idEmpresa INT NOT NULL AUTO_INCREMENT,
    rubro VARCHAR(50),
    director VARCHAR(40),
    idCliente INT NOT NULL,
    FOREIGN KEY (idCliente) REFERENCES UsuarioCliente(idCliente),
    PRIMARY KEY (idEmpresa)
);

CREATE TABLE IF NOT EXISTS Persona (
    idPersona INT NOT NULL AUTO_INCREMENT,
    idCliente INT NOT NULL,
    FOREIGN KEY (idCliente) REFERENCES UsuarioCliente(idCliente),
    PRIMARY KEY (idPersona)
);

CREATE TABLE IF NOT EXISTS infoLog (
    idLog INT NOT NULL AUTO_INCREMENT,
    numeroError INT,
    error VARCHAR(300),
    idUsuarioAcceso INT,
    FOREIGN KEY (idUsuarioAcceso) REFERENCES UsuarioAcceso(idUsuarioAcceso),
    PRIMARY KEY (idLog)
);

DELIMITER $$

-- ---------------------------------------------------------------------
-- CARGAR LOG
-- Sin START TRANSACTION/COMMIT propios: si lo llama un SP con transacción abierta,
-- el log queda dentro de esa transacción (antes el START TRANSACTION interno
-- hacía un commit implícito de lo que el SP llamador tenía pendiente).
-- Sin handler propio: si el INSERT falla, el error sube al handler del llamador.
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Cargar_Log$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Cargar_Log`(
    IN `Numero_Error_IN` INT,
    IN `Mensaje_IN` VARCHAR(500),
    IN `Proceso_IN` VARCHAR(50),
    IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    INSERT INTO infoLog (numeroError, error, idUsuarioAcceso)
    VALUES (Numero_Error_IN, LEFT(CONCAT(Proceso_IN, ' ', Mensaje_IN), 300), ID_Usuario_IN);

END$$

-- ---------------------------------------------------------------------
-- INICIALIZADOR
-- El diagrama no tiene tablas de catálogo para cargar; lo único que hay que
-- sembrar es el primer usuario de acceso (administrador, ID 1).
-- La clave es un placeholder: hay que cambiarla desde la aplicación.
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Inicializador$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Inicializador`(

)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    DECLARE v_id_admin INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        DECLARE v_sqlstate CHAR(5) DEFAULT '';
        DECLARE v_errno INT DEFAULT 0;
        DECLARE v_text VARCHAR(512) DEFAULT '';
        DECLARE v_log_fallo TINYINT DEFAULT 0;
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET v_log_fallo = 1;

        -- Los diagnósticos se leen ANTES de cualquier otra sentencia (cualquier sentencia los pisa)
        GET DIAGNOSTICS CONDITION 1 v_sqlstate = RETURNED_SQLSTATE, v_errno = MYSQL_ERRNO, v_text = MESSAGE_TEXT;

        ROLLBACK;

        -- Primero ROLLBACK y recién después el log, para que el log del error quede guardado
        CALL Cargar_Log(v_errno, CONCAT('ERROR [', v_sqlstate, ']: ', LEFT(v_text, 400)), '[SQL] Inicializador()', NULL);

        IF v_log_fallo THEN
            SELECT CONCAT('ERROR: [', v_sqlstate, ':', v_errno, '] ', v_text, ' (además falló el registro en infoLog)') AS 'ERROR';
        END IF;

        RESIGNAL;
    END;

    IF NOT EXISTS (SELECT 1 FROM UsuarioAcceso) THEN

        START TRANSACTION;

            INSERT INTO UsuarioAcceso (nombreUsuario, clave, numeroIntentos, ultimoIntento)
            VALUES ('admin', 'CAMBIAR_CLAVE', 0, CURRENT_DATE());

            SET v_id_admin = LAST_INSERT_ID();

            CALL Cargar_Log(0, CONCAT('Se creó el usuario administrador inicial con ID = ', v_id_admin), '[SQL] Inicializador()', v_id_admin);

        COMMIT;

    END IF;
END$$

-- ---------------------------------------------------------------------
-- CREAR CLIENTE
-- Tipo_IN: 'P' = Persona, 'E' = Empresa (Rubro_IN y Director_IN solo se usan en Empresa)
-- ID_Usuario_IN: usuario de acceso que ejecuta la acción (infoLog apunta a UsuarioAcceso)
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Crear_Cliente$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Crear_Cliente`(
    IN `Nombre_IN` VARCHAR(40),
    IN `Ingreso_IN` DECIMAL(10,3),
    IN `Gastos_IN` DECIMAL(10,3),
    IN `Historial_IN` VARCHAR(100),
    IN `Tipo_IN` CHAR(1),
    IN `Rubro_IN` VARCHAR(50),
    IN `Director_IN` VARCHAR(40),
    IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    DECLARE v_id_cliente INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        DECLARE v_sqlstate CHAR(5) DEFAULT '';
        DECLARE v_errno INT DEFAULT 0;
        DECLARE v_text VARCHAR(512) DEFAULT '';
        DECLARE v_log_fallo TINYINT DEFAULT 0;
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET v_log_fallo = 1;

        -- Los diagnósticos se leen ANTES de cualquier otra sentencia (cualquier sentencia los pisa)
        GET DIAGNOSTICS CONDITION 1 v_sqlstate = RETURNED_SQLSTATE, v_errno = MYSQL_ERRNO, v_text = MESSAGE_TEXT;

        ROLLBACK;

        -- Primero ROLLBACK y recién después el log, para que el log del error quede guardado
        CALL Cargar_Log(v_errno, CONCAT('ERROR [', v_sqlstate, ']: ', LEFT(v_text, 400)), '[SQL] Crear_Cliente()', ID_Usuario_IN);

        IF v_log_fallo THEN
            SELECT CONCAT('ERROR: [', v_sqlstate, ':', v_errno, '] ', v_text, ' (además falló el registro en infoLog)') AS 'ERROR';
        END IF;

        RESIGNAL;
    END;

    IF Tipo_IN IS NULL OR UPPER(Tipo_IN) NOT IN ('P', 'E') THEN

        SELECT 'El tipo de cliente debe ser P (Persona) o E (Empresa).' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, 'Se intentó crear un cliente con un tipo inválido', '[SQL] Crear_Cliente()', ID_Usuario_IN);

    ELSEIF UPPER(Tipo_IN) = 'E' AND (Rubro_IN IS NULL OR Director_IN IS NULL) THEN

        SELECT 'Una empresa necesita rubro y director.' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, 'Se intentó crear una empresa sin rubro o sin director', '[SQL] Crear_Cliente()', ID_Usuario_IN);

    ELSE

        START TRANSACTION;

            INSERT INTO UsuarioCliente (nombre, ingreso, gastos, historial)
            VALUES (Nombre_IN, Ingreso_IN, Gastos_IN, Historial_IN);

            SET v_id_cliente = LAST_INSERT_ID();

            IF UPPER(Tipo_IN) = 'E' THEN
                INSERT INTO Empresa (rubro, director, idCliente) VALUES (Rubro_IN, Director_IN, v_id_cliente);
            ELSE
                INSERT INTO Persona (idCliente) VALUES (v_id_cliente);
            END IF;

            CALL Cargar_Log(0, CONCAT('Se creó el cliente ', Nombre_IN, ' (tipo ', UPPER(Tipo_IN), ') con ID = ', v_id_cliente), '[SQL] Crear_Cliente()', ID_Usuario_IN);

        COMMIT;

    END IF;
END$$

-- ---------------------------------------------------------------------
-- MODIFICAR CLIENTE
-- Nuevo_Rubro_IN / Nuevo_Director_IN: solo aplican si el cliente es Empresa;
-- si vienen en NULL se conserva el valor actual.
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Modificar_Cliente$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Modificar_Cliente`(
    IN `ID_Cliente_IN` INT,
    IN `Nuevo_Nombre_IN` VARCHAR(40),
    IN `Nuevo_Ingreso_IN` DECIMAL(10,3),
    IN `Nuevos_Gastos_IN` DECIMAL(10,3),
    IN `Nuevo_Historial_IN` VARCHAR(100),
    IN `Nuevo_Rubro_IN` VARCHAR(50),
    IN `Nuevo_Director_IN` VARCHAR(40),
    IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        DECLARE v_sqlstate CHAR(5) DEFAULT '';
        DECLARE v_errno INT DEFAULT 0;
        DECLARE v_text VARCHAR(512) DEFAULT '';
        DECLARE v_log_fallo TINYINT DEFAULT 0;
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET v_log_fallo = 1;

        -- Los diagnósticos se leen ANTES de cualquier otra sentencia (cualquier sentencia los pisa)
        GET DIAGNOSTICS CONDITION 1 v_sqlstate = RETURNED_SQLSTATE, v_errno = MYSQL_ERRNO, v_text = MESSAGE_TEXT;

        ROLLBACK;

        -- Primero ROLLBACK y recién después el log, para que el log del error quede guardado
        CALL Cargar_Log(v_errno, CONCAT('ERROR [', v_sqlstate, ']: ', LEFT(v_text, 400)), '[SQL] Modificar_Cliente()', ID_Usuario_IN);

        IF v_log_fallo THEN
            SELECT CONCAT('ERROR: [', v_sqlstate, ':', v_errno, '] ', v_text, ' (además falló el registro en infoLog)') AS 'ERROR';
        END IF;

        RESIGNAL;
    END;

    IF EXISTS (SELECT 1 FROM UsuarioCliente WHERE idCliente = ID_Cliente_IN) THEN

        START TRANSACTION;

            UPDATE UsuarioCliente
            SET nombre = Nuevo_Nombre_IN, ingreso = Nuevo_Ingreso_IN, gastos = Nuevos_Gastos_IN, historial = Nuevo_Historial_IN
            WHERE idCliente = ID_Cliente_IN;

            -- Si el cliente es Persona no hay fila en Empresa y este UPDATE no toca nada
            UPDATE Empresa
            SET rubro = COALESCE(Nuevo_Rubro_IN, rubro), director = COALESCE(Nuevo_Director_IN, director)
            WHERE idCliente = ID_Cliente_IN;

            CALL Cargar_Log(0, CONCAT('Se modificó correctamente al cliente ID = ', ID_Cliente_IN), '[SQL] Modificar_Cliente()', ID_Usuario_IN);

        COMMIT;

    ELSE

        SELECT 'Cliente indicado no existente en el sistema' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, CONCAT('Se intentó modificar un cliente inexistente, ID = ', ID_Cliente_IN), '[SQL] Modificar_Cliente()', ID_Usuario_IN);

    END IF;
END$$

-- ---------------------------------------------------------------------
-- ELIMINAR CLIENTE
-- Borrado físico: el diagrama no tiene estado de usuario para un borrado lógico.
-- Primero se borran Empresa/Persona (FK) y después el cliente.
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Eliminar_Cliente$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Eliminar_Cliente`(
    IN `ID_Cliente_IN` INT,
    IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        DECLARE v_sqlstate CHAR(5) DEFAULT '';
        DECLARE v_errno INT DEFAULT 0;
        DECLARE v_text VARCHAR(512) DEFAULT '';
        DECLARE v_log_fallo TINYINT DEFAULT 0;
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET v_log_fallo = 1;

        -- Los diagnósticos se leen ANTES de cualquier otra sentencia (cualquier sentencia los pisa)
        GET DIAGNOSTICS CONDITION 1 v_sqlstate = RETURNED_SQLSTATE, v_errno = MYSQL_ERRNO, v_text = MESSAGE_TEXT;

        ROLLBACK;

        -- Primero ROLLBACK y recién después el log, para que el log del error quede guardado
        CALL Cargar_Log(v_errno, CONCAT('ERROR [', v_sqlstate, ']: ', LEFT(v_text, 400)), '[SQL] Eliminar_Cliente()', ID_Usuario_IN);

        IF v_log_fallo THEN
            SELECT CONCAT('ERROR: [', v_sqlstate, ':', v_errno, '] ', v_text, ' (además falló el registro en infoLog)') AS 'ERROR';
        END IF;

        RESIGNAL;
    END;

    IF EXISTS (SELECT 1 FROM UsuarioCliente WHERE idCliente = ID_Cliente_IN) THEN

        START TRANSACTION;

            DELETE FROM Empresa WHERE idCliente = ID_Cliente_IN;
            DELETE FROM Persona WHERE idCliente = ID_Cliente_IN;
            DELETE FROM UsuarioCliente WHERE idCliente = ID_Cliente_IN;

            CALL Cargar_Log(0, CONCAT('Se eliminó exitosamente al cliente ID = ', ID_Cliente_IN, ' del sistema'), '[SQL] Eliminar_Cliente()', ID_Usuario_IN);

        COMMIT;

    ELSE

        SELECT 'Cliente indicado no existente en el sistema' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, CONCAT('Se intentó eliminar un cliente inexistente, ID = ', ID_Cliente_IN), '[SQL] Eliminar_Cliente()', ID_Usuario_IN);

    END IF;
END$$

