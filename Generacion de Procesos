-- ---------------------------------------------------------------------
-- REINICIADOR DE INTENTOS
-- Si pasaron más de 7 días desde el último intento, vuelve el contador a 0.
-- (Usa las columnas EXTRA numeroIntentos / ultimoIntento de UsuarioAcceso.)
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Reiniciador_Intentos$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Reiniciador_Intentos`(
    IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    DECLARE v_ultimo DATE;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        DECLARE v_sqlstate CHAR(5) DEFAULT '';
        DECLARE v_errno INT DEFAULT 0;
        DECLARE v_text VARCHAR(512) DEFAULT '';
        DECLARE v_log_fallo TINYINT DEFAULT 0;
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET v_log_fallo = 1;

        -- Los diagnósticos se leen ANTES de cualquier otra sentencia (cualquier sentencia los pisa)
        GET DIAGNOSTICS CONDITION 1 v_sqlstate = RETURNED_SQLSTATE, v_errno = MYSQL_ERRNO, v_text = MESSAGE_TEXT;

        ROLLBACK;

        -- Primero ROLLBACK y recién después el log, para que el log del error quede guardado
        CALL Cargar_Log(v_errno, CONCAT('ERROR [', v_sqlstate, ']: ', LEFT(v_text, 400)), '[SQL] Reiniciador_Intentos()', ID_Usuario_IN);

        IF v_log_fallo THEN
            SELECT CONCAT('ERROR: [', v_sqlstate, ':', v_errno, '] ', v_text, ' (además falló el registro en infoLog)') AS 'ERROR';
        END IF;

        RESIGNAL;
    END;

    IF EXISTS (SELECT 1 FROM UsuarioAcceso WHERE idUsuarioAcceso = ID_Usuario_IN) THEN

        SELECT ultimoIntento INTO v_ultimo FROM UsuarioAcceso WHERE idUsuarioAcceso = ID_Usuario_IN;

        IF v_ultimo IS NOT NULL AND DATEDIFF(CURRENT_DATE(), v_ultimo) > 7 THEN

            START TRANSACTION;

                UPDATE UsuarioAcceso SET numeroIntentos = 0 WHERE idUsuarioAcceso = ID_Usuario_IN;

                CALL Cargar_Log(0, CONCAT('Se reinició el contador de intentos del usuario ID = ', ID_Usuario_IN), '[SQL] Reiniciador_Intentos()', ID_Usuario_IN);

            COMMIT;

        END IF;

    ELSE

        SELECT 'Usuario indicado no existente en el sistema' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, CONCAT('Se intentó reiniciar los intentos de un usuario inexistente, ID = ', ID_Usuario_IN), '[SQL] Reiniciador_Intentos()', NULL);

    END IF;
END$$

-- ---------------------------------------------------------------------
-- ASIGNADO ESTADO
-- Estado_IN: 1 = Aprobado, 2 = Rechazado. Solo se puede asignar a un cliente
-- que está Pendiente (3). Usa la columna EXTRA UsuarioCliente.estado.
-- ---------------------------------------------------------------------
DROP PROCEDURE IF EXISTS Asignado_Estado$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `Asignado_Estado`(
    IN `ID_Cliente_IN` INT,
    IN `Estado_IN` TINYINT,
    IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

    DECLARE v_estado_actual TINYINT DEFAULT NULL;
    DECLARE v_texto VARCHAR(100) DEFAULT '';

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        DECLARE v_sqlstate CHAR(5) DEFAULT '';
        DECLARE v_errno INT DEFAULT 0;
        DECLARE v_text VARCHAR(512) DEFAULT '';
        DECLARE v_log_fallo TINYINT DEFAULT 0;
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET v_log_fallo = 1;

        -- Los diagnósticos se leen ANTES de cualquier otra sentencia (cualquier sentencia los pisa)
        GET DIAGNOSTICS CONDITION 1 v_sqlstate = RETURNED_SQLSTATE, v_errno = MYSQL_ERRNO, v_text = MESSAGE_TEXT;

        ROLLBACK;

        -- Primero ROLLBACK y recién después el log, para que el log del error quede guardado
        CALL Cargar_Log(v_errno, CONCAT('ERROR [', v_sqlstate, ']: ', LEFT(v_text, 400)), '[SQL] Asignado_Estado()', ID_Usuario_IN);

        IF v_log_fallo THEN
            SELECT CONCAT('ERROR: [', v_sqlstate, ':', v_errno, '] ', v_text, ' (además falló el registro en infoLog)') AS 'ERROR';
        END IF;

        RESIGNAL;
    END;

    IF Estado_IN IS NULL OR Estado_IN NOT IN (1, 2) THEN

        SELECT 'El estado debe ser 1 (Aprobado) o 2 (Rechazado).' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, 'Se intentó asignar un estado inválido', '[SQL] Asignado_Estado()', ID_Usuario_IN);

    ELSEIF NOT EXISTS (SELECT 1 FROM UsuarioCliente WHERE idCliente = ID_Cliente_IN) THEN

        SELECT 'No existe un cliente con dicha ID.' AS 'ADVERTENCIA';
        CALL Cargar_Log(45000, 'Se intentó gestionar un cliente inexistente', '[SQL] Asignado_Estado()', ID_Usuario_IN);

    ELSE

        SELECT estado INTO v_estado_actual FROM UsuarioCliente WHERE idCliente = ID_Cliente_IN;

        IF v_estado_actual <> 3 THEN

            SELECT 'No se puede cambiar el estado de un cliente ya gestionado.' AS 'ADVERTENCIA';
            CALL Cargar_Log(45000, CONCAT('Se intentó cambiar el estado de un cliente ya gestionado, ID = ', ID_Cliente_IN), '[SQL] Asignado_Estado()', ID_Usuario_IN);

        ELSE

            START TRANSACTION;

                UPDATE UsuarioCliente SET estado = Estado_IN WHERE idCliente = ID_Cliente_IN;

                IF Estado_IN = 1 THEN
                    SET v_texto = CONCAT('Se aprobó de forma exitosa al cliente ID = ', ID_Cliente_IN);
                ELSE
                    SET v_texto = CONCAT('Se rechazó de forma exitosa al cliente ID = ', ID_Cliente_IN);
                END IF;

                CALL Cargar_Log(0, v_texto, '[SQL] Asignado_Estado()', ID_Usuario_IN);

            COMMIT;

        END IF;

    END IF;
END$$

