   ELSE
   
   	START TRANSACTION;
      
      	INSERT INTO UsuarioAcceso (nombreUsuario, clave, salt, numeroIntentos, ultimoIntento)
         VALUES (Nombre_IN, Clave_IN, Salt_IN, 0, CURRENT_DATE());
         
         SET id_nuevo = LAST_INSERT_ID();
         
         CALL Cargar_Log(0,CONCAT('Se creó el usuario ',Nombre_IN,' con ID = ',id_nuevo),'[SQL] Crear_Usuario()',ID_Usuario_IN);
      
      COMMIT;
   
   END IF;

END

