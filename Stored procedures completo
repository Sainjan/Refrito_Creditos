-- BUSCAR SOLICITUD
-- Bandera_IN = TRUE -> gestionar: trae UNA sola solicitud (la más antigua) con ese estado y esa fecha exacta. Estado_Solicitud_IN y Fecha_Solicitud_IN son obligatorios y Men_Mas_Fec_IN se ignora.
-- Bandera_IN = FALSE -> listar: trae todas las solicitudes que cumplan los filtros. Estado y fecha son opcionales (NULL = sin filtro).
-- Estado_Solicitud_IN: 'Pendiente', 'Aprobado' o 'Rechazado'
-- Men_Mas_Fec_IN: '<' antes de la fecha, '=' en la fecha, '>' después de la fecha (NULL = '=')
-- Mensaje_OUT / Exito_OUT: Exito_OUT = 1 si salió todo bien, 0 si no (y Mensaje_OUT dice qué falló)

CREATE DEFINER=`root`@`localhost` PROCEDURE `Buscar_Solicitud`(
	IN `Bandera_IN` BOOLEAN,
	IN `Estado_Solicitud_IN` VARCHAR(20),
	IN `Fecha_Solicitud_IN` DATE,
	IN `Men_Mas_Fec_IN` CHAR(1),
	OUT `Mensaje_OUT` VARCHAR(200),
	OUT `Exito_OUT` BOOLEAN
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

	DECLARE operador CHAR(1) DEFAULT '=';
	DECLARE cantidad INT DEFAULT 0;

	DECLARE validador TINYINT DEFAULT 0;

	DECLARE EXIT HANDLER FOR SQLEXCEPTION
   BEGIN
   
      GET DIAGNOSTICS CONDITION 1 @sqlstate = RETURNED_SQLSTATE, @errno = MYSQL_ERRNO, @text = MESSAGE_TEXT;
      
      BEGIN
      
      	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
         	SET validador = 1;
         
         CALL Cargar_Log(@errno,CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',LEFT(@text,200)),'[SQL] Buscar_Solicitud()',NULL);
      
      END;
      
      IF validador THEN
      
      	SELECT CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',@text,'\n(Además falló el registro en infoLog)') AS 'ERROR';
      
      END IF;
      
      RESIGNAL;
   
   END;

   SET Exito_OUT = 0;
   
   SET Mensaje_OUT = '';
   
   IF (Bandera_IN IS NULL) THEN
   
   	SET Mensaje_OUT = 'La bandera debe ser true o false.';
   
   ELSEIF ((Estado_Solicitud_IN IS NOT NULL) AND (Estado_Solicitud_IN NOT IN ('Pendiente','Aprobado','Rechazado'))) THEN
   
   	SET Mensaje_OUT = 'El estado debe ser Pendiente, Aprobado o Rechazado.';
   
   ELSEIF ((Bandera_IN) AND ((Estado_Solicitud_IN IS NULL) OR (Fecha_Solicitud_IN IS NULL))) THEN
   
   	SET Mensaje_OUT = 'Para gestionar una solicitud hacen falta el estado y la fecha.';
   
   ELSEIF ((NOT Bandera_IN) AND (Men_Mas_Fec_IN IS NOT NULL) AND (Men_Mas_Fec_IN NOT IN ('<','=','>'))) THEN
   
   	SET Mensaje_OUT = 'El criterio de fecha debe ser <, = o >.';
   
   ELSE
   
      IF Bandera_IN THEN
      
      	SET operador = '=';
      
      ELSE
      
      	SET operador = COALESCE(Men_Mas_Fec_IN,'=');
      
      END IF;
      
      SELECT COUNT(*) INTO cantidad
      FROM Solicitud s
      WHERE ((Estado_Solicitud_IN IS NULL) OR (s.estadoSolicitud = Estado_Solicitud_IN))
      AND ((Fecha_Solicitud_IN IS NULL)
      	OR ((operador = '=') AND (s.fechaSolicitud = Fecha_Solicitud_IN))
         OR ((operador = '<') AND (s.fechaSolicitud < Fecha_Solicitud_IN))
         OR ((operador = '>') AND (s.fechaSolicitud > Fecha_Solicitud_IN)));
      
      IF cantidad = 0 THEN
      
      	SET Exito_OUT = NOT Bandera_IN;
         
         SET Mensaje_OUT = 'No se encontraron solicitudes con esos datos.';
      
      ELSE
      
      	SET Exito_OUT = 1;
         
         SET Mensaje_OUT = 'Búsqueda realizada correctamente.';
         
         IF Bandera_IN THEN
         
         	SELECT s.idSolicitud, s.idCliente, uc.nombre, s.ingresoAcutla, s.gastoAnual, s.estadoSolicitud, s.fechaSolicitud
            FROM Solicitud s
            INNER JOIN UsuarioCliente uc ON uc.idCliente = s.idCliente
            WHERE ((Estado_Solicitud_IN IS NULL) OR (s.estadoSolicitud = Estado_Solicitud_IN))
            AND ((Fecha_Solicitud_IN IS NULL)
            	OR ((operador = '=') AND (s.fechaSolicitud = Fecha_Solicitud_IN))
               OR ((operador = '<') AND (s.fechaSolicitud < Fecha_Solicitud_IN))
               OR ((operador = '>') AND (s.fechaSolicitud > Fecha_Solicitud_IN)))
            ORDER BY s.idSolicitud ASC
            LIMIT 1;
         
         ELSE
         
         	SELECT s.idSolicitud, s.idCliente, uc.nombre, s.ingresoAcutla, s.gastoAnual, s.estadoSolicitud, s.fechaSolicitud
            FROM Solicitud s
            INNER JOIN UsuarioCliente uc ON uc.idCliente = s.idCliente
            WHERE ((Estado_Solicitud_IN IS NULL) OR (s.estadoSolicitud = Estado_Solicitud_IN))
            AND ((Fecha_Solicitud_IN IS NULL)
            	OR ((operador = '=') AND (s.fechaSolicitud = Fecha_Solicitud_IN))
               OR ((operador = '<') AND (s.fechaSolicitud < Fecha_Solicitud_IN))
               OR ((operador = '>') AND (s.fechaSolicitud > Fecha_Solicitud_IN)))
            ORDER BY s.idSolicitud ASC;
         
         END IF;
      
      END IF;
   
   END IF;

END

