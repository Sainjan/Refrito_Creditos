USE Credito;

-- (este archivo solo tiene los Stored Procedures)
-- Convención de infoLog.numeroError: 0 -> operación exitosa / 45000 -> advertencia de validación / otro -> MYSQL_ERRNO del error capturado
------------------------------------------------------------------------------------------
CREATE DEFINER=`root`@`localhost` PROCEDURE `Inicializador`(
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

	DECLARE validador TINYINT DEFAULT 0;

	DECLARE EXIT HANDLER FOR SQLEXCEPTION
   BEGIN
   
      GET DIAGNOSTICS CONDITION 1 @sqlstate = RETURNED_SQLSTATE, @errno = MYSQL_ERRNO, @text = MESSAGE_TEXT;
      
      ROLLBACK;
      
      BEGIN
      
      	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
         	SET validador = 1;
         
         CALL Cargar_Log(@errno,CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',LEFT(@text,200)),'[SQL] Inicializador()',NULL);
      
      END;
      
      IF validador THEN
      
      	SELECT CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',@text,'\n(Además falló el registro en infoLog)') AS 'ERROR';
      
      END IF;
      
      RESIGNAL;
   
   END;

   IF NOT EXISTS (SELECT 1 FROM UsuarioAcceso WHERE idUsuarioAcceso = 1) THEN
   
   	START TRANSACTION;
      
      	-- ID explícito: el 1 queda siempre para el Administrador (el AUTO_INCREMENT sigue desde el 2 para el resto)
      	INSERT INTO UsuarioAcceso (idUsuarioAcceso, nombreUsuario, clave, salt, numeroIntentos, ultimoIntento)
         VALUES (1, 'admin', 'CAMBIAR_CLAVE', 'CAMBIAR_SALT', 0, CURRENT_DATE());
         
         CALL Cargar_Log(0,'Se creó el usuario administrador con ID = 1','[SQL] Inicializador()',1);
      
      COMMIT;
   
   ELSEIF NOT EXISTS (SELECT 1 FROM UsuarioAcceso WHERE idUsuarioAcceso = 1 AND nombreUsuario = 'admin') THEN
   
   	SELECT 'El ID 1 está ocupado por un usuario que no es el administrador.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,'El ID 1 de UsuarioAcceso no pertenece al usuario admin','[SQL] Inicializador()',NULL);
   
   END IF;

END

