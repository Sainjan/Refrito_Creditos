-- ASIGNADOR ESTADO (Opcion_IN: 'Aprobado' o 'Rechazado'. Solo se puede asignar a una solicitud que está Pendiente)

CREATE DEFINER=`root`@`localhost` PROCEDURE `Asignador_Estado`(
	IN `ID_Solicitud_IN` INT,
	IN `Opcion_IN` VARCHAR(10),
	IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

	DECLARE estado_actual VARCHAR(20) DEFAULT NULL;

	DECLARE validador TINYINT DEFAULT 0;

	DECLARE EXIT HANDLER FOR SQLEXCEPTION
   BEGIN
   
      GET DIAGNOSTICS CONDITION 1 @sqlstate = RETURNED_SQLSTATE, @errno = MYSQL_ERRNO, @text = MESSAGE_TEXT;
      
      ROLLBACK;
      
      BEGIN
      
      	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
         	SET validador = 1;
         
         CALL Cargar_Log(@errno,CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',LEFT(@text,200)),'[SQL] Asignador_Estado()',ID_Usuario_IN);
      
      END;
      
      IF validador THEN
      
      	SELECT CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',@text,'\n(Además falló el registro en infoLog)') AS 'ERROR';
      
      END IF;
      
      RESIGNAL;
   
   END;

   IF ((Opcion_IN IS NULL) OR (Opcion_IN NOT IN ('Aprobado','Rechazado'))) THEN
   
   	SELECT 'La opción debe ser Aprobado o Rechazado.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,'Se intentó asignar una opción inválida a una solicitud','[SQL] Asignador_Estado()',ID_Usuario_IN);
   
   ELSEIF NOT EXISTS (SELECT 1 FROM Solicitud WHERE idSolicitud = ID_Solicitud_IN) THEN
   
   	SELECT 'No existe una solicitud con dicha ID.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,'Se intentó gestionar una solicitud inexistente','[SQL] Asignador_Estado()',ID_Usuario_IN);
   
   ELSE
   
   	SELECT estadoSolicitud INTO estado_actual FROM Solicitud WHERE idSolicitud = ID_Solicitud_IN;
      
      IF estado_actual != 'Pendiente' THEN
      
      	SELECT 'No se puede cambiar el estado de una solicitud ya gestionada.' AS 'ADVERTENCIA';
         
         CALL Cargar_Log(45000,CONCAT('Se intentó cambiar el estado de una solicitud ya gestionada, ID = ',ID_Solicitud_IN),'[SQL] Asignador_Estado()',ID_Usuario_IN);
      
      ELSE
      
      	START TRANSACTION;
         
         	UPDATE Solicitud SET estadoSolicitud = Opcion_IN WHERE idSolicitud = ID_Solicitud_IN;
            
            CALL Cargar_Log(0,CONCAT('Se cambió el estado de la solicitud ID = ',ID_Solicitud_IN,' a ',Opcion_IN),'[SQL] Asignador_Estado()',ID_Usuario_IN);
         
         COMMIT;
      
      END IF;
   
   END IF;

END

