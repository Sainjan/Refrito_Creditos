-- CARGAR LOG (sin START TRANSACTION/COMMIT ni handler propios: así el log queda dentro de la transacción del SP que lo llama y, si el INSERT falla, el error sube al handler del llamador)

CREATE DEFINER=`root`@`localhost` PROCEDURE `Cargar_Log`(
	IN `Numero_Error_IN` INT,
	IN `Mensaje_IN` VARCHAR(500),
	IN `Proceso_IN` VARCHAR(50),
	IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN


   -- Si el usuario no existe en UsuarioAcceso se guarda NULL, así un ID inválido no hace fallar el log por la FK
   INSERT INTO infoLog (numeroError, error, idUsuarioAcceso)
   SELECT Numero_Error_IN, LEFT(CONCAT(Proceso_IN,' ',Mensaje_IN),300), (SELECT idUsuarioAcceso FROM UsuarioAcceso WHERE idUsuarioAcceso = ID_Usuario_IN);

END

