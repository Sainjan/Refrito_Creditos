-- SOLICITAR CREDITO (inserta una Solicitud en estado Pendiente con la fecha de hoy. Ingreso_IN va a Solicitud.ingresoAcutla y Gastos_IN a Solicitud.gastoAnual. Nombre_IN actualiza el nombre del cliente. Un cliente no puede tener dos solicitudes Pendientes a la vez)

CREATE DEFINER=`root`@`localhost` PROCEDURE `Solicitar_Credito`(
	IN `ID_Cliente_IN` INT,
	IN `Nombre_IN` VARCHAR(40),
	IN `Ingreso_IN` INT,
	IN `Gastos_IN` DECIMAL(10,2)
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

	DECLARE id_solicitud INT DEFAULT 0;

	DECLARE validador TINYINT DEFAULT 0;

	DECLARE EXIT HANDLER FOR SQLEXCEPTION
   BEGIN
   
      GET DIAGNOSTICS CONDITION 1 @sqlstate = RETURNED_SQLSTATE, @errno = MYSQL_ERRNO, @text = MESSAGE_TEXT;
      
      ROLLBACK;
      
      BEGIN
      
      	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
         	SET validador = 1;
         
         CALL Cargar_Log(@errno,CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',LEFT(@text,200)),'[SQL] Solicitar_Credito()',NULL);
      
      END;
      
      IF validador THEN
      
      	SELECT CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',@text,'\n(Además falló el registro en infoLog)') AS 'ERROR';
      
      END IF;
      
      RESIGNAL;
   
   END;

   IF ((ID_Cliente_IN IS NULL) OR (Nombre_IN IS NULL) OR (Ingreso_IN IS NULL) OR (Gastos_IN IS NULL)) THEN
   
   	SELECT 'La solicitud necesita cliente, nombre, ingresos y gastos.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,'Se intentó solicitar un crédito con datos incompletos','[SQL] Solicitar_Credito()',NULL);
   
   ELSEIF ((Ingreso_IN < 0) OR (Gastos_IN < 0)) THEN
   
   	SELECT 'Los ingresos y los gastos no pueden ser negativos.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,CONCAT('Se intentó solicitar un crédito con ingresos o gastos negativos, cliente ID = ',ID_Cliente_IN),'[SQL] Solicitar_Credito()',NULL);
   
   ELSEIF NOT EXISTS (SELECT 1 FROM UsuarioCliente WHERE idCliente = ID_Cliente_IN) THEN
   
   	SELECT 'No existe un cliente con dicha ID.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,CONCAT('Se intentó solicitar un crédito para un cliente inexistente, ID = ',ID_Cliente_IN),'[SQL] Solicitar_Credito()',NULL);
   
   ELSEIF EXISTS (SELECT 1 FROM Solicitud WHERE idCliente = ID_Cliente_IN AND estadoSolicitud = 'Pendiente') THEN
   
   	SELECT 'El cliente ya tiene una solicitud pendiente.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,CONCAT('Se intentó solicitar un crédito para un cliente con una solicitud pendiente, ID = ',ID_Cliente_IN),'[SQL] Solicitar_Credito()',NULL);
   
   ELSE
   
   	START TRANSACTION;
      
      	UPDATE UsuarioCliente SET nombre = Nombre_IN WHERE idCliente = ID_Cliente_IN;
         
         INSERT INTO Solicitud (ingresoAcutla, gastoAnual, estadoSolicitud, fechaSolicitud, idCliente)
         VALUES (Ingreso_IN, Gastos_IN, 'Pendiente', CURRENT_DATE(), ID_Cliente_IN);
         
         SET id_solicitud = LAST_INSERT_ID();
         
         CALL Cargar_Log(0,CONCAT('Se registró la solicitud de crédito ID = ',id_solicitud,' del cliente ID = ',ID_Cliente_IN),'[SQL] Solicitar_Credito()',NULL);
      
      COMMIT;
   
   END IF;

END

