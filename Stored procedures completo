-- CREAR USUARIO (solo el Administrador, ID 1, puede crear usuarios. Los usuarios creados nunca son administradores: el ID 1 está reservado, así que reciben ID 2 en adelante y no pueden crear usuarios. Clave_IN y Salt_IN llegan ya procesados desde la aplicación)

CREATE DEFINER=`root`@`localhost` PROCEDURE `Crear_Usuario`(
	IN `Nombre_IN` VARCHAR(40),
	IN `Clave_IN` VARCHAR(200),
	IN `Salt_IN` VARCHAR(100),
	IN `ID_Usuario_IN` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN

	DECLARE id_nuevo INT DEFAULT 0;

	DECLARE validador TINYINT DEFAULT 0;

	DECLARE EXIT HANDLER FOR SQLEXCEPTION
   BEGIN
   
      GET DIAGNOSTICS CONDITION 1 @sqlstate = RETURNED_SQLSTATE, @errno = MYSQL_ERRNO, @text = MESSAGE_TEXT;
      
      ROLLBACK;
      
      BEGIN
      
      	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
         	SET validador = 1;
         
         CALL Cargar_Log(@errno,CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',LEFT(@text,200)),'[SQL] Crear_Usuario()',ID_Usuario_IN);
      
      END;
      
      IF validador THEN
      
      	SELECT CONCAT('ERROR: [',@sqlstate,':',@errno,']\n',@text,'\n(Además falló el registro en infoLog)') AS 'ERROR';
      
      END IF;
      
      RESIGNAL;
   
   END;

   IF ((ID_Usuario_IN IS NULL) OR (ID_Usuario_IN != 1)) THEN
   
   	SELECT 'Solo el administrador puede crear usuarios.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,'Un usuario que no es administrador intentó crear un usuario','[SQL] Crear_Usuario()',ID_Usuario_IN);
   
   ELSEIF ((Nombre_IN IS NULL) OR (TRIM(Nombre_IN) = '') OR (Clave_IN IS NULL) OR (Clave_IN = '') OR (Salt_IN IS NULL) OR (Salt_IN = '')) THEN
   
   	SELECT 'El usuario necesita nombre, clave y salt.' AS 'ADVERTENCIA';
      
      CALL Cargar_Log(45000,'Se intentó crear un usuario sin nombre, clave o salt','[SQL] Crear_Usuario()',ID_Usuario_IN);
   
